{
  "name": "contasuite-web",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"tests/**/*.mjs\" \"*.{ts,cjs,js,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"tests/**/*.mjs\" \"*.{ts,cjs,js,json,html}\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "@fontsource/material-symbols-outlined": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "postcss": "^8.5.0",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.0",
    "typescript-eslint": "8.46.4",
    "vite": "^7.1.0"
  }
}
