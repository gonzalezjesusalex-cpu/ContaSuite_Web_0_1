# Los scripts generan .env con claves aleatorias en el primer arranque.
DATABASE_URL=postgresql+psycopg://contasuite:CAMBIAR@127.0.0.1:5432/contasuite
POSTGRES_PASSWORD=CAMBIAR
# Clave de alta inicial; deja de autorizar después de crear el primer administrador.
APP_TOKEN=GENERAR_CLAVE_DE_AL_MENOS_24_CARACTERES
AGENT_TOKEN=GENERAR_OTRA_CLAVE_DE_AL_MENOS_24_CARACTERES
SEED_DEMO=false

# CS-Storage: explicit absolute local roots, JSON array. Empty means no external roots authorized.
# Windows example: ["C:/ContaSuite-Demo/servidor"]
CS_STORAGE_ALLOWED_ROOTS=[]
CS_STORAGE_MAX_FILE_MB=25
# SMB Windows: lista JSON de raíces UNC explícitamente autorizadas (sin contraseñas).
# Usa comillas simples alrededor del JSON para conservar las barras invertidas.
CS_STORAGE_SMB_ALLOWED_ROOTS='[]'
